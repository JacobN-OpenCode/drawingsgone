#include <windows.h>

101 ICON "app.ico"
102 ICON "app-off.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          0x00040004L
FILETYPE        0x00000001L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Jacob Navaratne"
      VALUE "FileDescription",  "DrawingsGone - a live view of your screen with annotation layers filtered out"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "DrawingsGone"
      VALUE "LegalCopyright",   "(c) 2026 Jacob Navaratne"
      VALUE "OriginalFilename", "DrawingsGone.exe"
      VALUE "ProductName",      "DrawingsGone"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
